    "configuration": {
      "title": "UWF Companion",
      "properties": {
        "uwf.workflowStagesPath": {
          "type": "string",
          "scope": "window",
          "default": ".github/skills/uwf-sw_dev/stages.yaml",
          "description": "Legacy setting retained for workspace stage discovery overrides; MCP runtime resolves workflows dynamically."
        },
        "uwf.workflow": {
          "type": "string",
          "scope": "window",
          "default": "sw_dev",
          "description": "Default UAW workflow persona name used for gate audits and cost reporting."
        },
        "uwf.dataDir": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Explicit UAW run data directory override (absolute or relative to the workspace root)."
        },
        "uwf.stateDir": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Optional UAW host state registry directory override (defaults to $XDG_STATE_HOME/uaw)."
        },
        "uwf.mcpServerPath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Optional path to an external uaw-mcp entrypoint script (defaults to the bundled runtime/bin/uaw-mcp.mjs)."
        },
        "uwf.mcpServerUrl": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Optional remote Streamable HTTP uaw-mcp/v1 endpoint URL (requires https:// except loopback hosts)."
        },
        "uwf.nodePath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Optional path to a Node.js (>= 22.13.0) executable used when spawning the stdio uaw-mcp server."
        },
        "uwf.allowedRoots": {
          "type": "array",
          "scope": "machine",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Optional allowed workspace/data root paths passed to --allowed-roots when spawning the stdio uaw-mcp server."
        },
        "uwf.refreshIntervalMs": {
          "type": "number",
          "scope": "machine",
          "default": 0,
          "description": "Optional polling interval in milliseconds for refreshing views (useful with remote HTTP MCP endpoints; 0 disables polling)."
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "stage:bundle": "node scripts/stage-bundle.mjs",
    "build": "node esbuild.mjs && node scripts/stage-bundle.mjs && node scripts/stage-bundle.mjs --check-manifest",
    "vscode:prepublish": "node esbuild.mjs --production && node scripts/stage-bundle.mjs && node scripts/stage-bundle.mjs --check-manifest",
    "watch": "node esbuild.mjs --watch",
    "package": "vsce package",
    "test": "npm run typecheck && npm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/vscode": "^1.101.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "typescript": "^5.3.0"
  },
  "dependencies": {}
}
