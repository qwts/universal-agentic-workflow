{
  "name": "uwf-companion",
  "displayName": "UWF Companion",
  "description": "Universal Agentic Workflow (UAW) — VS Code companion, MCP runtime provider, and Copilot agents/skills/prompts",
  "version": "0.1.0",
  "publisher": "uwf",
  "repository": {
    "type": "git",
    "url": "https://github.com/qwts/universal-agentic-workflow.git",
    "directory": "uwf-companion"
  },
  "engines": {
    "node": ">=22.13.0",
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Running the UAW MCP runtime or overriding runtime paths/endpoints is disabled in untrusted workspaces.",
      "restrictedConfigurations": [
        "uwf.nodePath",
        "uwf.mcpServerPath",
        "uwf.mcpServerUrl",
        "uwf.stateDir",
        "uwf.dataDir",
        "uwf.allowedRoots",
        "uwf.refreshIntervalMs"
      ]
    }
  },
  "activationEvents": [
    "workspaceContains:.github/skills",
    "workspaceContains:.uaw-runs"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "uwf.openDashboard",
        "title": "UWF: Open Workflow Dashboard"
      },
      {
        "command": "uwf.openWorkflowState",
        "title": "UWF: Open Workflow State"
      },
      {
        "command": "uwf.openStages",
        "title": "UWF: Open Stages"
      },
      {
        "command": "uwf.openRequirements",
        "title": "UWF: Open Requirements"
      },
      {
        "command": "uwf.openReview",
        "title": "UWF: Open Review Findings"
      },
      {
        "command": "uwf.openAdrs",
        "title": "UWF: Open ADRs"
      },
      {
        "command": "uwf.openDiscoveries",
        "title": "UWF: Open Discoveries"
      },
      {
        "command": "uwf.openIssues",
        "title": "UWF: Open Issues"
      },
      {
        "command": "uwf.openQuestions",
        "title": "UWF: Open Questions"
      },
      {
        "command": "uwf.resolveQuestion",
        "title": "UWF: Resolve Pending Question"
      },
      {
        "command": "uwf.openCost",
        "title": "UWF: Open Cost & Token Report"
      },
      {
        "command": "uwf.checkGates",
        "title": "UWF: Audit Stage Gates"
      },
      {
        "command": "uwf.selectRun",
        "title": "UWF: Select Active Run / Data Directory"
      },
      {
        "command": "uwf.setRemoteToken",
        "title": "UWF: Set Remote MCP Auth Token"
      },
      {
        "command": "uwf.exportReport",
        "title": "UWF: Export Report (CSV/JSON)"
      },
      {
        "command": "uwf.refreshAll",
        "title": "UWF: Refresh All"
      }
    ],
    "views": {
      "uwf-sidebar": [
        {
          "id": "uwf.workflowTree",
          "name": "Workflow"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "uwf-sidebar",
          "title": "UWF Companion",
          "icon": "$(database)"
        }
      ]
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "uwf.uaw-mcp",
        "label": "Universal Agentic Workflow (UAW)"
